{
	"name": "explainer-video-agent",
	"version": "0.1.0",
	"description": "A GitHub App that turns a pull request into a short narrated explainer video on `/explain-vid`.",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.19"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"deploy": "vite build && wrangler deploy",
		"check:types": "tsc --noEmit"
	},
	"dependencies": {
		"@cloudflare/sandbox": "^0.12.14",
		"@flue/github": "^2.3.0",
		"@flue/runtime": "^2.3.0",
		"hono": "^4.12.32",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.39.2",
		"@cloudflare/workers-types": "^5.20261006.1",
		"@flue/cli": "^2.3.0",
		"@flue/vite": "^2.3.0",
		"@types/node": "^22.10.10",
		"typescript": "^7.0.2",
		"vite": "^8.0.14",
		"wrangler": "^4.113.0"
	}
}
